{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src",
    "test"
  ],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/modules/contact"
    },
    {
      "path": "../../packages/modules/health"
    }
  ],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "tsBuildInfoFile": ".tsbuildinfo/app.tsbuildinfo",
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ],
      "@test/*": [
        "${configDir}/test/*"
      ],
      "@vantion/domain/*": [
        "../../packages/domain/src/*.js"
      ],
      "@vantion/module-contact/*": [
        "../../packages/modules/contact/src/*.js"
      ],
      "@vantion/module-health/*": [
        "../../packages/modules/health/src/*.js"
      ]
    }
  }
}
