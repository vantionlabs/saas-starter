{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../packages/database"
    },
    {
      "path": "../../packages/modules/contact"
    },
    {
      "path": "../../packages/modules/jobs"
    },
    {
      "path": "../../packages/modules/webhooks"
    }
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ],
      "#src/*": [
        "${configDir}/src/*"
      ],
      "@vantion/database/*": [
        "../../packages/database/src/*.js"
      ],
      "@vantion/module-contact/*": [
        "../../packages/modules/contact/src/*.js"
      ],
      "@vantion/module-iam/*": [
        "../../packages/modules/iam/src/*.js"
      ],
      "@vantion/module-jobs/*": [
        "../../packages/modules/jobs/src/*.js"
      ],
      "@vantion/module-webhooks/*": [
        "../../packages/modules/webhooks/src/*.js"
      ]
    }
  }
}
