{
  "name": "@vantion/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx --conditions=development --env-file-if-exists=../../.env src/Main.ts",
    "build": "tsc -b tsconfig.json && vite build",
    "start": "node build/bundle/main.js",
    "check": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@vantion/database": "workspace:*",
    "@vantion/module-agent": "workspace:*",
    "@vantion/module-billing": "workspace:*",
    "@vantion/module-contact": "workspace:*",
    "@vantion/module-files": "workspace:*",
    "@vantion/module-iam": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
