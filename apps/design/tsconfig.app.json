{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/tokens"
    },
    {
      "path": "../../packages/modules/iam"
    },
    {
      "path": "../../packages/modules/contact"
    }
  ],
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "tsBuildInfoFile": ".tsbuildinfo/app.tsbuildinfo",
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ],
      "@vantion/module-contact/*": [
        "../../packages/modules/contact/src/*.js"
      ],
      "@vantion/module-iam/*": [
        "../../packages/modules/iam/src/*.js"
      ],
      "@vantion/tokens/*": [
        "../../packages/tokens/src/*.js"
      ],
      "@vantion/ui/*": [
        "../../packages/ui/src/*.tsx"
      ]
    }
  }
}
