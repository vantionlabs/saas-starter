{
  "name": "@vantion/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/*.ts"
  },
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./build/src/*"
    }
  },
  "scripts": {
    "dev": "bun --watch --conditions=development --env-file=../../.env src/Main.ts",
    "build": "tsc -b tsconfig.json && bun run bundle",
    "start": "bun build/bundle/main.js",
    "check": "tsc -b tsconfig.json",
    "test": "vitest run",
    "bundle": "vite build"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@vantion/database": "workspace:*",
    "@vantion/domain": "workspace:*",
    "@vantion/module-agent": "workspace:*",
    "@vantion/module-assistant": "workspace:*",
    "@vantion/module-billing": "workspace:*",
    "@vantion/module-contact": "workspace:*",
    "@vantion/module-files": "workspace:*",
    "@vantion/module-health": "workspace:*",
    "@vantion/module-iam": "workspace:*",
    "@vantion/module-notifications": "workspace:*",
    "@vantion/module-webhooks": "workspace:*",
    "@vantion/redis": "workspace:*",
    "@vantion/telemetry": "workspace:*",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
