{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/database"
    },
    {
      "path": "../../packages/modules/iam"
    },
    {
      "path": "../../packages/modules/notifications"
    },
    {
      "path": "../../packages/modules/contact"
    },
    {
      "path": "../../packages/modules/health"
    }
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ],
      "#src/*": [
        "${configDir}/src/*"
      ],
      "@vantion/database/*": [
        "../../packages/database/src/*.js"
      ],
      "@vantion/domain/*": [
        "../../packages/domain/src/*.js"
      ],
      "@vantion/module-iam/*": [
        "../../packages/modules/iam/src/*.js"
      ],
      "@vantion/module-notifications/*": [
        "../../packages/modules/notifications/src/*.js"
      ],
      "@vantion/module-contact/*": [
        "../../packages/modules/contact/src/*.js"
      ],
      "@vantion/module-health/*": [
        "../../packages/modules/health/src/*.js"
      ]
    }
  }
}
