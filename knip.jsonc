{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    // 3,558 files of somebody else's source. Reading it is the point; auditing
    // it is not ours to do.
    "repos/**",
    // A vendored third-party skill. Ours to install and read, not to audit.
    ".claude/skills/impeccable/**",
  ],
  // Knip *executes* a config file to read its plugin options, and these two
  // refuse to load outside their own runtime: Metro's resolves
  // `tailwind.config` through its own resolver, and Playwright's throws
  // deliberately when no e2e database has been prepared. Ignoring the files is
  // not enough — the plugin has to be off.
  "metro": false,
  "playwright": false,
  "ignoreDependencies": [
    /**
     * Named in `lefthook.yml` and in `.secretlintrc.json`, neither of which
     * knip reads, and run as a command rather than imported.
     */
    "@secretlint/secretlint-rule-preset-recommend",
    /**
     * The runtime every `.ts` script here is executed with — `pnpm vendor`,
     * the migration runner, `new:module`. Knip resolves the binary from the
     * scripts that call it and still counts the manifest entry as unused,
     * because nothing `import`s it.
     */
    "tsx",
    // Knip's Expo plugin infers these from `app.json` keys that are core Expo
    // configuration — `userInterfaceStyle` is not `expo-system-ui`. Verified by
    // reading the file rather than by installing two packages to quieten it.
    "expo-updates",
    "expo-system-ui",
    // A TypeScript plugin named in `tsconfig.base.json`, installed by
    // `@effect/tsgo`'s patch step rather than declared.
    "@effect/language-service",
    /**
     * Workspace packages a module depends on for its *types* and its build
     * order, through tsconfig project references, without importing a value.
     * Removing them would break `tsc -b` ordering while satisfying knip, which
     * is the wrong trade.
     */
    "@vantion/domain",
    "@vantion/emails",
    "@vantion/module-iam",
    "@vantion/module-files",
    "@vantion/module-contact",
    // Metro resolves these from the app root rather than through an import.
    "react-native-css-interop",
    // Used by `@vantion/ui` components this app renders, and declared here so
    // Tailwind's `@source` scan resolves them from the scanning project.
    "lucide-react"
  ],
  /**
   * The catalog check is off, and only because of one entry it cannot see the
   * use of: `@lucas-barake/effect-form` is the pin `scripts/vendor-sources.json`
   * vendors `repos/effect-form` at, and `tooling/test/vendor-sources.test.ts`
   * fails if the catalog does not carry it. Nothing imports it — the `-react`
   * package is what application code uses — so knip is right about the import
   * graph and wrong about whether the entry may go.
   *
   * That test is the check this one would otherwise be, for the only catalog
   * entry that has this shape.
   */
  "rules": { "catalog": "off" },
  "workspaces": {
    "packages/*": {
      // Every package exports `./*`, so each source file is a public entry
      // point. Knip cannot infer that from a wildcard export map.
      "entry": ["src/**/*.{ts,tsx}", "test/**/*.test.{ts,tsx}", "*.ts"]
    },
    "packages/modules/*": {
      "entry": ["src/**/*.ts", "test/**/*.test.ts"]
    },
    "apps/*": {
      "entry": ["src/**/*.{ts,tsx}", "test/**/*.test.{ts,tsx}", "*.ts"]
    },
    "apps/mobile": {
      // Metro and Babel read these by name; nothing imports them. The router
      // root is discovered by file path for the same reason.
      "entry": ["src/**/*.{ts,tsx}", "test/**/*.test.ts", "*.config.js"]
    },
    "e2e": {
      "entry": ["*.ts", "tests/**/*.spec.ts"]
    },
    "evals": {
      "entry": ["*.ts", "src/**/*.ts", "test/**/*.test.ts"]
    },
    ".": {
      "entry": [
        ".claude/hooks/*.mjs",
        // Read by `railway config plan|apply`, never imported.
        ".railway/railway.ts"
      ]
    }
  }
}
