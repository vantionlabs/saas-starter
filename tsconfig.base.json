{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "moduleDetection": "force",
    "composite": true,
    "resolveJsonModule": true,
    "declaration": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "declarationMap": true,
    "noImplicitReturns": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": false,
    "noErrorTruncation": true,
    "allowJs": false,
    "checkJs": false,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "noUncheckedIndexedAccess": true,
    "strictNullChecks": true,
    "target": "ES2022",
    "module": "ESNext",
    "incremental": true,
    "removeComments": false,
    "jsx": "react-jsx",
    "plugins": [
      {
        "name": "@effect/language-service",
        "quickinfoEffectParameters": "always",
        "namespaceImportPackages": [
          "effect",
          "@effect/*"
        ],
        "topLevelNamedReexports": "follow",
        "diagnostics": false
      }
    ],
    "paths": {
      "@vantion/domain/*": [
        "./packages/domain/src/*.js"
      ],
      "@vantion/module-iam/*": [
        "./packages/modules/iam/src/*.js"
      ],
      "@vantion/module-notifications/*": [
        "./packages/modules/notifications/src/*.js"
      ],
      "@vantion/database/*": [
        "./packages/database/src/*.js"
      ],
      "@vantion/module-contact/*": [
        "./packages/modules/contact/src/*.js"
      ],
      "@vantion/module-health/*": [
        "./packages/modules/health/src/*.js"
      ],
      "@vantion/tokens/*": [
        "./packages/tokens/src/*.js"
      ],
      "@vantion/ui/*": [
        "./packages/ui/src/*.tsx"
      ],
      "@vantion/module-jobs/*": [
        "./packages/modules/jobs/src/*.js"
      ],
      "@vantion/module-webhooks/*": [
        "./packages/modules/webhooks/src/*.js"
      ],
      "@vantion/module-billing/*": [
        "./packages/modules/billing/src/*.js"
      ],
      "@vantion/emails/*": [
        "./packages/emails/src/*.js"
      ],
      "@vantion/module-files/*": [
        "./packages/modules/files/src/*.js"
      ],
      "@vantion/module-agent/*": [
        "./packages/modules/agent/src/*.js"
      ]
    }
  }
}
