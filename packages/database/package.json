{
  "name": "@vantion/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "development": "./src/*.ts",
      "types": "./src/*.ts",
      "default": "./build/src/*.js"
    }
  },
  "scripts": {
    "check": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json && bun run bundle",
    "migrate": "bun --conditions=development --env-file=../../.env src/bin/migrate.ts",
    "test": "vitest run",
    "bundle": "vite build && cp -R src/migrations build/bundle/migrations"
  },
  "dependencies": {
    "@effect/sql-pg": "catalog:",
    "@vantion/domain": "workspace:*",
    "effect": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
