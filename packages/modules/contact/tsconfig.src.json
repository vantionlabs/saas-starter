{
  "extends": "../../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../database"
    },
    {
      "path": "../iam"
    },
    {
      "path": "../jobs"
    }
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ],
      "@vantion/database/*": [
        "../../../packages/database/src/*.js"
      ],
      "@vantion/module-iam/*": [
        "../../../packages/modules/iam/src/*.js"
      ],
      "@vantion/module-notifications/*": [
        "../../../packages/modules/notifications/src/*.js"
      ],
      "@vantion/module-jobs/*": [
        "../../../packages/modules/jobs/src/*.js"
      ]
    }
  }
}
