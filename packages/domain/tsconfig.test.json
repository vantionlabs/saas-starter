{
  "extends": "../../tsconfig.base.json",
  "include": [
    "test",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "tsconfig.src.json"
    },
    {
      "path": "../modules/iam"
    },
    {
      "path": "../modules/contact"
    },
    {
      "path": "../modules/billing"
    },
    {
      "path": "../modules/files"
    },
    {
      "path": "../modules/health"
    }
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "noEmit": true,
    "tsBuildInfoFile": ".tsbuildinfo/test.tsbuildinfo",
    "paths": {
      "@vantion/module-iam/*": [
        "../modules/iam/src/*.js"
      ],
      "@vantion/module-notifications/*": [
        "../../packages/modules/notifications/src/*.js"
      ],
      "@vantion/module-contact/*": [
        "../../packages/modules/contact/src/*.js"
      ],
      "@vantion/module-billing/*": [
        "../../packages/modules/billing/src/*.js"
      ],
      "@vantion/module-files/*": [
        "../../packages/modules/files/src/*.js"
      ],
      "@vantion/module-health/*": [
        "../../packages/modules/health/src/*.js"
      ]
    }
  }
}
