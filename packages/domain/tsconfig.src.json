{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@vantion/module-iam/*": [
        "../modules/iam/src/*.js"
      ],
      "@vantion/module-notifications/*": [
        "../../packages/modules/notifications/src/*.js"
      ]
    }
  },
  "references": [
    {
      "path": "../modules/iam"
    }
  ]
}
