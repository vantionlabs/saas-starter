{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "references": [
    {
      "path": "../modules/billing"
    },
    {
      "path": "../modules/assistant"
    },
    {
      "path": "../modules/contact"
    },
    {
      "path": "../modules/files"
    },
    {
      "path": "../modules/iam"
    },
    {
      "path": "../tokens"
    },
    {
      "path": "../emails"
    },
    {
      "path": "../modules/webhooks"
    }
  ],
  "compilerOptions": {
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "outDir": "build/src",
    "tsBuildInfoFile": ".tsbuildinfo/src.tsbuildinfo",
    "rootDir": "src",
    "paths": {
      "@/*": [
        "${configDir}/src/*"
      ],
      "@vantion/emails/*": [
        "../../packages/emails/src/*.tsx"
      ],
      "@vantion/module-assistant/*": [
        "../../packages/modules/assistant/src/*.js"
      ],
      "@vantion/module-billing/*": [
        "../../packages/modules/billing/src/*.js"
      ],
      "@vantion/module-contact/*": [
        "../../packages/modules/contact/src/*.js"
      ],
      "@vantion/module-files/*": [
        "../../packages/modules/files/src/*.js"
      ],
      "@vantion/module-iam/*": [
        "../../packages/modules/iam/src/*.js"
      ],
      "@vantion/module-webhooks/*": [
        "../../packages/modules/webhooks/src/*.js"
      ],
      "@vantion/tokens/*": [
        "../../packages/tokens/src/*.js"
      ]
    }
  }
}
