# The application's database role, and it must not be able to bypass row-level
# security — a superuser, or any role holding BYPASSRLS, ignores every policy in
# this schema while `pg_class.relrowsecurity` still reads true. `docker compose`
# provisions `vantion` for exactly this, and a test asserts the connection
# cannot bypass, because the failure is otherwise completely silent.
DATABASE_URL=postgresql://vantion:vantion@localhost:5432/vantion

# The cross-tenant connection, read only by the admin application. It names the
# `admin` role, which holds BYPASSRLS, and nothing customer-facing is ever given
# it: the boundary between the two is enforced by Postgres rather than by a lint
# rule, which is the point of there being two roles at all.
#
# `@vantion/module-admin` refuses to start without it rather than falling back
# to DATABASE_URL — the quiet fallback would be the application's own
# connection, which is the one thing that must never read across tenants. Left
# empty, there is no admin surface, which is the right default.
#
# postgresql://admin:admin@localhost:5432/vantion
ADMIN_DATABASE_URL=

# Seconds to cache what a person may do. `0` — the default — means no cache at
# all, and that is deliberate rather than conservative.
#
# The entitlement cache next door is always on, because a plan changes when
# Stripe says so and its webhook already arrives seconds to minutes late: a
# cache measured in seconds sits inside a delay the product has anyway. A
# revoked permission has no such delay to hide in.
#
# Turning this on is for somebody with a measured reason. What you buy: member
# changes — an override set or cleared, a role's permissions edited — invalidate
# immediately on every replica, because the store is shared. What you accept: a
# role edit made through better-auth's own endpoints, which this module does not
# wrap, is bounded by this number and nothing else. Keep it small.
PERMISSION_CACHE_TTL=0

# Outbound webhook requests this process may have in flight at once.
#
# The worker dispatches several jobs concurrently and each event fans out to
# several endpoints, so the two would otherwise multiply into more sockets than
# anybody chose. This is one permit pool across both.
#
# Both loops were sequential before, which is bounded and slow in the worst way:
# one receiver that accepts a connection and then sits there held up every job
# behind it for the length of the timeout, so one customer's wedged server was
# everybody's delay.
WEBHOOK_CONCURRENCY=20
DATABASE_SSL=false
# PORT is the API server's port; the client takes its own from WEB_URL, so
# `pnpm dev` can run both without a second variable to keep in step.
PORT=3000

# better-auth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# The API's address as the browser sees it. VITE_-prefixed because it is baked
# into the client bundle — a public address, not a secret. Every auth route and
# every RPC lives on the API, so the browser talks to it directly.
VITE_AUTH_BASE_URL=http://localhost:3000

# Only when the web app and the API sit on different subdomains of one parent,
# so the session cookie can be scoped to `.example.com` and count as same-site.
# Leave empty when they share a host, as they do locally.
#
# It cannot be a public suffix: two *.up.railway.app hosts can never share a
# cookie, so splitting the two across Railway's generated domains needs a domain
# of your own.
AUTH_COOKIE_DOMAIN=

# Billing. Left empty, checkout and the customer portal refuse rather than
# pretending to work — a fake URL would send somebody to a page that does not
# exist, which is worse than being told billing is not configured. Every
# organization is on the free plan until a webhook says otherwise.
#
# `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints the
# signing secret to use locally. The plan a price maps to is read from its
# metadata (`plan=pro`), never from a hard-coded price id, because price ids
# differ between every account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Background jobs *and* rate limiting. Committed work is written to the
# `outboxEvent` table in the same transaction as the change it describes, and a
# relay moves it into BullMQ.
#
# Left empty, the queue is in-memory: enqueueing and relaying still work and are
# still transactional, but nothing survives a restart. That is enough to run the
# app and its tests on a fresh clone, and not enough to run a worker in
# production. `docker compose up -d` provides one locally.
#
# It is also where the rate limiter counts, and that part is not a performance
# question. Without it each process keeps its own counter, so N replicas give a
# caller N times the limit — and on the OTP path the limit is the security
# boundary rather than a politeness measure. One instance without Redis is fine;
# more than one is not. See docs/redis.md.
REDIS_URL=

# How many reverse proxies stand in front of this server.
#
# The auth endpoints are rate-limited per caller, and behind a proxy the caller's
# real address arrives in `X-Forwarded-For` — a list each hop appends to, so the
# entry to trust is counted from the right. Left at 0 the header is ignored
# entirely and the socket address is used, which is correct when nothing is in
# front. Set it to the number of proxies you actually run (Railway: 1); setting
# it higher than the truth lets a caller forge the entry that gets counted.
TRUST_PROXY=0

# Optional: enables "Sign in with Google" when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single sign-on. Nothing is needed here to use it: a provider is a row an
# organization's owner or admin adds from /settings/sso, and the plan decides
# whether they may.
#
# This variable is only for registering an OIDC provider by *discovery*.
# better-auth checks a discovery URL against the trusted origins before fetching
# it, because the URL comes from whoever is registering the provider and
# fetching an arbitrary one from your server is a request-forgery primitive.
# Trusting a customer's identity provider is therefore an operator's decision
# and a restart — which is why the settings screen registers explicit endpoints
# instead, and why this is normally empty.
#
# Comma-separated origins, e.g. https://acme.okta.com,https://login.contoso.com
SSO_DISCOVERY_ORIGINS=

# What the transactional emails call this product — the subject line of a
# sign-in mail is the first thing a customer of a renamed fork ever reads.
PRODUCT_NAME=vantion

# Transactional email only. Bulk or marketing sending must not share this account —
# Resend's terms require recipient consent, and sharing a domain would put auth
# deliverability at risk.
#
# Left empty, mail is written to the server log rather than sent, so magic links
# and verification mails are followable on a fresh clone with no account.
RESEND_API_KEY=
EMAIL_FROM=vantion@example.com

# The assistant. Unset, the RPCs refuse with AssistantUnavailable rather than
# answering from a lookup table — a deployment should not be able to ship an
# assistant that quietly is not one.
#
# ASSISTANT_MODEL=scripted turns on the deterministic stand-in the tests use:
# it calls the same tools through the same approval gate, so the loop can be
# exercised without a key or a bill. Never a silent fallback; you ask for it.
OPENROUTER_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_MODEL_ID=anthropic/claude-haiku-4.5

# The MCP server in apps/mcp runs as whatever this key resolves to. Create one
# at /settings/api-keys and give it the narrowest role that does the job — the
# tools can do exactly what that role can do. See docs/mcp.md.
VANTION_API_KEY=

# File storage. With no bucket, uploads are written to FILES_DIR and served by
# the API from signed, expiring URLs — which is what lets a fresh clone upload
# and download a file with no account anywhere. Nothing there survives a
# container restart, and the port says so with `durable: false`.
FILES_DIR=.data/uploads
# Set all of these and uploads go straight to storage instead, with the browser
# talking to it directly. S3_ENDPOINT is for R2, Tigris, MinIO and everything
# else that speaks S3 without being S3; leave it empty for AWS.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Tracing. Unset means no exporter is installed at all — pointing one at nothing
# retries on a schedule and fills the log with connection failures.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Each process names itself (vantion-server, vantion-worker); set this only to
# override, and never to the same value for both — two services under one name
# is a trace nobody can read.
OTEL_SERVICE_NAME=
# Sent as the Authorization header, which is what hosted collectors expect.
OTEL_EXPORTER_OTLP_HEADERS=

# Error tracking. Traces are not aggregation: a span says what one request did,
# and this is what says the same failure has happened four hundred times since
# Tuesday. Unset, nothing is reported and no SDK is loaded.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# The browser's own. A separate DSN because these are a separate project in
# every error tracker — client errors have different volumes, different noise
# and different owners from server ones.
#
# VITE_-prefixed, so like VITE_AUTH_BASE_URL it is baked into the client bundle
# at build time and must be a build argument for the web image, not a runtime
# variable. Unset, the SDK chunk is never fetched and a boundary crash goes to
# the console.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# What fraction of page loads carry a performance trace. A cost decision, not a
# correctness one; web vitals are reported regardless of it.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# The version failures are attributed to. A deploy usually sets this to the
# commit sha, which is what makes "this started on Tuesday" answerable.
RELEASE=
