{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "name": "saas-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint && (git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true)",
    "dev": "bun run --parallel --filter @vantion/server --filter @vantion/web --filter @vantion/worker dev",
    "dev:all": "bun run --parallel --filter './apps/*' dev",
    "admin": "bun run --filter @vantion/admin dev",
    "brand": "bun run --filter @vantion/brand dev",
    "design": "bun run --filter @vantion/design dev",
    "marketing": "bun run --filter @vantion/marketing dev",
    "mobile": "bun run --filter @vantion/mobile dev",
    "services": "docker compose up -d",
    "services:stop": "docker compose down",
    "services:logs": "docker compose logs -f",
    "services:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "bun run --filter @vantion/database migrate",
    "seed": "bun --conditions=development --env-file=.env tooling/seed.ts",
    "build": "tsc -b tsconfig.json && bun run --filter @vantion/database --filter @vantion/server --filter @vantion/worker --filter @vantion/web bundle",
    "build:images": "docker build -f apps/server/Dockerfile -t vantion-server . && docker build -f apps/web/Dockerfile -t vantion-web . && docker build -f apps/admin/Dockerfile -t vantion-admin . && docker build -f apps/worker/Dockerfile -t vantion-worker . && docker build -f apps/marketing/Dockerfile -t vantion-marketing . && docker build -f apps/brand/Dockerfile -t vantion-brand .",
    "clean": "rm -rf apps/*/build apps/*/.tsbuildinfo packages/*/build packages/*/.tsbuildinfo packages/modules/*/build packages/modules/*/.tsbuildinfo apps/web/dist apps/web/.output apps/web/.tanstack coverage",
    "check": "tsc -b tsconfig.json && tsc -p tsconfig.tools.json",
    "check:watch": "tsc -b tsconfig.json --watch",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "fix": "bun run format && bun run lint:fix",
    "test": "bun --bun vitest run",
    "coverage": "bun --bun vitest run --coverage",
    "e2e": "bun run --filter @vantion/e2e test",
    "e2e:install": "bun run --filter @vantion/e2e install-browsers",
    "e2e:ui": "bun run --filter @vantion/e2e test:ui",
    "evals": "bun run --filter @vantion/evals evals",
    "preflight": "bun run format && bun run check && bun run lint && bun run hygiene && bun run test",
    "gate": "bun run preflight && bun run e2e",
    "knip": "knip",
    "secrets": "secretlint --secretlintignore .secretlintignore '**/*'",
    "deps:check": "syncpack lint",
    "deps:update": "syncpack update",
    "hygiene": "bun run knip && bun run deps:check && bun run secrets",
    "new:module": "bun tooling/new-module.ts",
    "vendor": "bun scripts/vendor.ts",
    "sync:skills": "bun scripts/sync-effect-skills.ts",
    "agents": "bun tooling/agents.ts",
    "skills:check": "bun tooling/agents.ts --check"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "catalog:",
    "@secretlint/secretlint-rule-preset-recommend": "catalog:",
    "@types/node": "catalog:",
    "@vantion/scripts": "workspace:*",
    "@vitest/coverage-v8": "^4.1.10",
    "dprint": "^0.55.2",
    "effect": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "railway": "catalog:",
    "secretlint": "catalog:",
    "syncpack": "catalog:",
    "typescript": "^7.0.2",
    "vitest": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "packages/modules/*",
      "scripts",
      "tooling",
      "e2e",
      "evals"
    ],
    "catalog": {
      "@base-ui/react": "^1.7.0",
      "@better-auth/expo": "~1.6.33",
      "@better-auth/scim": "~1.6.33",
      "@better-auth/sso": "~1.6.33",
      "@effect/ai-openrouter": "4.0.0-rc.109",
      "@effect/atom-react": "4.0.0-rc.109",
      "@effect/opentelemetry": "4.0.0-rc.109",
      "@effect/platform-bun": "4.0.0-rc.109",
      "@effect/sql-pg": "4.0.0-rc.109",
      "@effect/vitest": "4.0.0-rc.109",
      "@lucas-barake/effect-form": "0.25.0-beta.6",
      "@lucas-barake/effect-form-react": "0.26.0-beta.5",
      "@opentelemetry/api": "^1.9.1",
      "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
      "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
      "@opentelemetry/sdk-metrics": "^2.10.0",
      "@opentelemetry/sdk-trace-base": "^2.10.0",
      "@opentelemetry/sdk-trace-node": "^2.10.0",
      "@playwright/test": "^1.63.0",
      "@react-email/components": "^1.0.12",
      "@react-email/render": "^2.1.0",
      "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
      "@sentry/browser": "^10.75.0",
      "@sentry/node": "^10.75.0",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-router": "^1.170.29",
      "@tanstack/react-start": "^1.168.48",
      "@tanstack/react-table": "^8.21.3",
      "@testcontainers/postgresql": "^12.1.0",
      "@testing-library/jest-dom": "^7.0.1",
      "@testing-library/react": "^16.3.2",
      "@testing-library/user-event": "^14.6.4",
      "@types/bun": "1.4.2",
      "@types/node": "^26.2.0",
      "@types/pg": "^8.21.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@vitejs/plugin-react": "^6.0.5",
      "better-auth": "~1.6.33",
      "bullmq": "^5.68.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "cmdk": "^1.1.1",
      "effect": "4.0.0-rc.109",
      "happy-dom": "^20.0.0",
      "ioredis": "^5.9.0",
      "knip": "^6.37.0",
      "lefthook": "^2.1.14",
      "lucide-react": "^1.31.0",
      "motion": "^13.4.0",
      "nitro": "^3.0.260610-beta",
      "pg": "^8.23.0",
      "railway": "^3.10.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "resend": "^6.20.0",
      "scheduler": "^0.27.0",
      "secretlint": "^13.0.5",
      "sonner": "^2.0.8",
      "stripe": "^19.2.0",
      "syncpack": "^15.3.3",
      "tailwind-merge": "^3.6.0",
      "tailwindcss": "^4.3.3",
      "vite": "^8.2.1",
      "vitest": "^4.1.10",
      "web-vitals": "^6.2.2",
      "yaml": "^2.9.1"
    }
  },
  "trustedDependencies": [
    "dprint"
  ],
  "overrides": {
    "@lucas-barake/effect-form": "0.25.0-beta.6",
    "@effect/platform-node-shared": "4.0.0-rc.109"
  }
}
